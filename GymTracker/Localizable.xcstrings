    "mobility.assessment.wall.slide.arm.elevation.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slide your arms up the wall as far as they go while keeping your back, elbows and wrists in contact. Record the angle of your forearm at the highest position you can hold, then repeat on the other side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les bras vers le haut aussi loin que possible en gardant le dos, les coudes et les poignets en contact. Notez l’angle de l’avant-bras à la position la plus haute que vous pouvez tenir, puis répétez de l’autre côté."
          }
        }
      }
    },
    "mobility.assessment.wall.slide.arm.elevation.limitations" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It cannot tell whether your ribs or lower back lifted off the wall, and it does not separate shoulder movement from upper-back movement."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne dit pas si vos côtes ou le bas de votre dos se sont décollés du mur, et ne distingue pas le mouvement de l’épaule de celui du haut du dos."
          }
        }
      }
    },
    "mobility.assessment.wall.slide.arm.elevation.measures" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far your arm rises with your back and ribs kept against the wall."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quelle hauteur votre bras monte en gardant le dos et les côtes contre le mur."
          }
        }
      }
    },
    "mobility.assessment.wall.slide.arm.elevation.name" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wall-slide arm elevation"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élévation des bras glissés au mur"
          }
        }
      }
    },
    "mobility.assessment.wall.slide.arm.elevation.setup" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand with your back, head and hips against a wall, ribs down, arms bent with elbows and wrists touching the wall."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debout, dos, tête et hanches contre le mur, côtes basses, bras fléchis avec les coudes et les poignets au mur."
          }
        }
      }
    },
    "mobility.assessment.wall.squat.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Squat down as far as you can without your hands, knees or chest touching the wall and without your heels lifting, then record which of those criteria you kept."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descendez en squat aussi bas que possible sans que vos mains, vos genoux ou votre poitrine touchent le mur et sans décoller les talons, puis notez lesquels de ces critères vous avez respectés."
          }
        }
      }
    },
    "mobility.assessment.wall.squat.limitations" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It records several criteria as one observation, so it cannot show which joint limited the movement or by how much."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle enregistre plusieurs critères en une seule observation, donc elle ne montre pas quelle articulation a limité le mouvement ni dans quelle mesure."
          }
        }
      }
    },
    "mobility.assessment.wall.squat.measures" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether you can reach a full squat facing a wall while keeping your heels down and staying off the wall."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous pouvez atteindre un squat complet face au mur en gardant les talons au sol et sans toucher le mur."
          }
        }
      }
    },
    "mobility.assessment.wall.squat.name" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wall squat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Squat face au mur"
          }
        }
      }
    },
    "mobility.assessment.wall.squat.setup" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand facing a wall, toes a hand’s width from it, feet about shoulder width apart."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debout face au mur, orteils à une largeur de main du mur, pieds écartés à la largeur des épaules."
          }
        }
      }
    },
