    "mobility.assessment.straddle.frog.abduction.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open both legs as wide as you can hold, then record the angle between your thighs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez les deux jambes aussi largement que vous pouvez tenir, puis notez l’angle entre vos cuisses."
          }
        }
      }
    },
    "mobility.assessment.straddle.frog.abduction.limitations" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is one angle for both legs together, so it cannot show which side contributed more, and small changes in torso position change the result."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est un seul angle pour les deux jambes, donc elle ne montre pas quel côté a contribué le plus, et un léger changement de position du torse modifie le résultat."
          }
        }
      }
    },
    "mobility.assessment.straddle.frog.abduction.measures" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
