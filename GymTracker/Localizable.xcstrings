    "mobility.assessment.hub.involves" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, each entered by hand. You need wall and floor space, and you can skip any of them."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, chacune saisie à la main. Il vous faut un mur et de l’espace au sol, et vous pouvez en passer n’importe laquelle."
          }
        }
      }
    },
    "mobility.assessment.knee.to.wall.dorsiflexion.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slide your foot back until your knee just touches the wall with your heel staying down. Measure the distance from your big toe to the wall in centimetres, then repeat on the other side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reculez le pied jusqu’à ce que le genou touche tout juste le mur, talon toujours au sol. Mesurez la distance entre le gros orteil et le mur en centimètres, puis répétez de l’autre côté."
          }
        }
      }
    },
    "mobility.assessment.knee.to.wall.dorsiflexion.limitations" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It cannot tell whether your heel lifted slightly or whether your knee tracked inward, and the distance depends on your foot length."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne dit pas si votre talon s’est légèrement soulevé ni si votre genou est parti vers l’intérieur, et la distance dépend de la longueur de votre pied."
          }
        }
      }
    },
    "mobility.assessment.knee.to.wall.dorsiflexion.measures" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The distance from your toe to the wall at the furthest point where your knee still touches with your heel down."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distance entre votre orteil et le mur au point le plus éloigné où le genou touche encore avec le talon au sol."
          }
        }
      }
    },
    "mobility.assessment.knee.to.wall.dorsiflexion.name" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knee-to-wall dorsiflexion"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorsiflexion genou au mur"
          }
        }
      }
    },
    "mobility.assessment.knee.to.wall.dorsiflexion.setup" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face a wall with one foot flat on the floor, second toe and knee pointing straight at the wall, heel down."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face au mur, un pied à plat au sol, le deuxième orteil et le genou pointant droit vers le mur, talon au sol."
          }
        }
      }
    },
