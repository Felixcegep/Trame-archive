    "mobility.assessment.sleeper.shoulder.rotation.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeping your shoulder blade against the floor, rotate your forearm toward the floor as far as it goes without pain. Record the angle of your forearm, then repeat on the other side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gardant l’omoplate contre le sol, tournez l’avant-bras vers le sol aussi loin que possible sans douleur. Notez l’angle de l’avant-bras, puis répétez de l’autre côté."
          }
        }
      }
    },
    "mobility.assessment.sleeper.shoulder.rotation.limitations" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It cannot tell whether your shoulder blade moved, and forearm position is only an indirect reading of shoulder rotation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne dit pas si votre omoplate a bougé, et la position de l’avant-bras n’est qu’une lecture indirecte de la rotation de l’épaule."
          }
        }
      }
    },
    "mobility.assessment.sleeper.shoulder.rotation.measures" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far your shoulder rotates inward with your shoulder blade held still."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De combien votre épaule tourne vers l’intérieur pendant que l’omoplate reste immobile."
          }
        }
      }
    },
    "mobility.assessment.sleeper.shoulder.rotation.name" : {
      "extractionState" : "stale",
