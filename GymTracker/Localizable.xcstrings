    "mobility.assessment.90.90.hip.rotation.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without leaning back, lift the front shin off the floor as far as you can and record the angle of that thigh. Turn around and repeat for the other side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans vous pencher en arrière, soulevez le tibia avant du sol aussi haut que possible et notez l’angle de cette cuisse. Tournez-vous et répétez de l’autre côté."
          }
        }
      }
    },
    "mobility.assessment.90.90.hip.rotation.limitations" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It cannot separate hip movement from movement of your pelvis or lower back, and it does not measure the joint angle directly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne distingue pas le mouvement de la hanche de celui du bassin ou du bas du dos, et ne mesure pas directement l’angle articulaire."
          }
        }
      }
    },
    "mobility.assessment.90.90.hip.rotation.measures" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far each hip turns in this seated position using your own effort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De combien chaque hanche tourne dans cette position assise par vos propres moyens."
          }
        }
      }
    },
    "mobility.assessment.90.90.hip.rotation.name" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90/90 hip rotation"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotation de hanche 90/90"
          }
        }
      }
    },
    "mobility.assessment.90.90.hip.rotation.setup" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit on the floor with one leg in front bent to about 90 degrees and the other out to the side bent to about 90 degrees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assoyez-vous au sol, une jambe devant fléchie à environ 90 degrés et l’autre sur le côté fléchie à environ 90 degrés."
          }
        }
      }
    },
    "mobility.assessment.active.straight.leg.raise.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeping both legs straight and the other leg on the floor, raise one leg as high as you can without help. Record the angle of the raised thigh, then repeat with the other leg."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gardant les deux jambes tendues et l’autre jambe au sol, levez une jambe le plus haut possible sans aide. Notez l’angle de la cuisse levée, puis répétez avec l’autre jambe."
          }
        }
      }
    },
    "mobility.assessment.active.straight.leg.raise.limitations" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It cannot tell whether your knee bent, whether your pelvis tilted, or which tissue limited the movement."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne dit pas si votre genou s’est fléchi, si votre bassin a basculé, ni quel tissu a limité le mouvement."
          }
        }
      }
    },
    "mobility.assessment.active.straight.leg.raise.measures" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How high you can raise one straight leg using your own effort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quelle hauteur vous pouvez lever une jambe tendue par vos propres moyens."
          }
        }
      }
    },
    "mobility.assessment.active.straight.leg.raise.name" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active straight-leg raise"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élévation active de la jambe tendue"
          }
        }
      }
    },
    "mobility.assessment.active.straight.leg.raise.setup" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lie on your back on the floor with both legs straight and your lower back in a neutral position."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couchez-vous sur le dos au sol, les deux jambes tendues et le bas du dos en position neutre."
          }
        }
      }
    },
