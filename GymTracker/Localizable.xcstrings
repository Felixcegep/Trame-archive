    "mobility.assessment.open.book.rotation.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeping your knees stacked and down, open your top arm across your body toward the floor behind you. Stop where you can hold the position, record the angle your chest reached, then repeat on the other side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gardant les genoux superposés et au sol, ouvrez le bras du dessus vers le sol derrière vous. Arrêtez-vous là où vous pouvez tenir la position, notez l’angle atteint par la poitrine, puis répétez de l’autre côté."
          }
        }
      }
    },
    "mobility.assessment.open.book.rotation.limitations" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It cannot tell whether your knees lifted, and it does not separate shoulder movement from chest movement."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne dit pas si vos genoux se sont soulevés et ne distingue pas le mouvement de l’épaule de celui de la poitrine."
          }
        }
      }
    },
    "mobility.assessment.open.book.rotation.measures" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far your chest opens toward the floor while your knees stay stacked."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De combien votre poitrine s’ouvre vers le sol pendant que vos genoux restent superposés."
          }
        }
      }
    },
    "mobility.assessment.open.book.rotation.name" : {
