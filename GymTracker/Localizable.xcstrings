    "mobility.assessment.straddle.frog.abduction.setup" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit in a straddle or kneel in a frog position with both legs open and your torso upright."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assoyez-vous en grand écart ou placez-vous en position de grenouille, les deux jambes ouvertes et le torse droit."
          }
        }
      }
    },
    "mobility.assessment.summary.count" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ saved · %2$@ skipped"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ enregistrée(s) · %2$@ passée(s)"
          }
        }
      }
    },
    "mobility.assessment.thoracic.rotation.seated.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn your chest as far as you can to one side while keeping your hips still. Hold at the end of the turn, record the angle you reached, then repeat on the other side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tournez la poitrine le plus loin possible d’un côté en gardant les hanches immobiles. Tenez la position en fin de rotation, notez l’angle atteint, puis répétez de l’autre côté."
          }
        }
      }
    },
    "mobility.assessment.thoracic.rotation.seated.limitations" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It cannot separate movement of your upper back from movement of your lower back or hips, and it does not show why one side turns further."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne distingue pas le mouvement du haut du dos de celui du bas du dos ou des hanches, et n’indique pas pourquoi un côté tourne davantage."
          }
        }
      }
    },
    "mobility.assessment.thoracic.rotation.seated.measures" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far your upper back turns to each side while your hips stay square."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De combien votre haut du dos tourne de chaque côté pendant que vos hanches restent de face."
          }
        }
      }
    },
    "mobility.assessment.thoracic.rotation.seated.name" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoracic rotation, seated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotation thoracique, assis"
          }
        }
      }
    },
    "mobility.assessment.thoracic.rotation.seated.setup" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit upright on a bench or the floor, knees together and hips square, with your arms crossed over your chest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous bien droit sur un banc ou au sol, genoux serrés et hanches de face, les bras croisés sur la poitrine."
          }
        }
      }
    },
