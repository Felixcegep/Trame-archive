    "mobility.assessment.sleeper.shoulder.rotation.setup" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lie on the shoulder being recorded, that upper arm out in front at about 90 degrees and the elbow bent to 90 degrees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couchez-vous sur l’épaule à enregistrer, ce bras devant vous à environ 90 degrés et le coude fléchi à 90 degrés."
          }
        }
      }
    },
    "mobility.assessment.soleus.wall.stretch.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bend the knee toward the wall as far as it goes with the heel staying down. Record the angle of your shin from vertical, then repeat on the other side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fléchissez le genou vers le mur aussi loin que possible en gardant le talon au sol. Notez l’angle de votre tibia par rapport à la verticale, puis répétez de l’autre côté."
          }
        }
      }
    },
    "mobility.assessment.soleus.wall.stretch.limitations" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It cannot tell whether your heel lifted, and it does not separate ankle movement from movement further up the leg."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne dit pas si votre talon s’est soulevé et ne distingue pas le mouvement de la cheville de celui du reste de la jambe."
          }
        }
      }
    },
    "mobility.assessment.soleus.wall.stretch.measures" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far your shin travels forward over your foot with the knee bent and the heel down."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De combien votre tibia avance au-dessus du pied, genou fléchi et talon au sol."
          }
        }
      }
    },
    "mobility.assessment.soleus.wall.stretch.name" : {
