{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/lists/**",
              "components/navigation/**",
              "components/progress/**",
              "components/workout/**",
              "ui_kits/ios-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityHeatmap'] > JSXAttribute > JSXIdentifier[name!=/^(?:weeks|monthLabels|title|subtitle|cell|gap|legend|style|key|ref|className|style|children)$/]",
        "message": "<ActivityHeatmap> doesn't accept that prop. Declared props: weeks, monthLabels, title, subtitle, cell, gap, legend, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|variant|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: color, variant, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tint|card)$/]",
        "message": "<Badge> variant must be one of 'tint' | 'card'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|icon|trailingIcon|fullWidth|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, color, icon, trailingIcon, fullWidth, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|prominent|bordered|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'prominent' | 'bordered' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|radius|padding|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, radius, padding, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:standard|elevated|outlined|current|completed|accent|muted)$/]",
        "message": "<Card> variant must be one of 'standard' | 'elevated' | 'outlined' | 'current' | 'completed' | 'accent' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|met|planned|performed|suggested|checks|style|key|ref|className|style|children)$/]",
        "message": "<ComparisonPanel> doesn't accept that prop. Declared props: title, met, planned, performed, suggested, checks, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|state|columns|prescription|lastTime|completedSets|totalSets|elapsed|children|onAddSet|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ExerciseCard> doesn't accept that prop. Declared props: name, state, columns, prescription, lastTime, completedSets, totalSets, elapsed, children, onAddSet, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:current|completed|collapsed)$/]",
        "message": "<ExerciseCard> state must be one of 'current' | 'completed' | 'collapsed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HistoryRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|date|duration|exercises|sets|source|onClick|style|key|ref|className|style|children)$/]",
        "message": "<HistoryRow> doesn't accept that prop. Declared props: title, date, duration, exercises, sets, source, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|filled|weight|color|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, filled, weight, color, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|color|shape|size|surface|iconSize|filled|style|key|ref|className|style|children)$/]",
        "message": "<IconChip> doesn't accept that prop. Declared props: icon, color, shape, size, surface, iconSize, filled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconChip'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|rounded)$/]",
        "message": "<IconChip> shape must be one of 'circle' | 'rounded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|color|surface|title|subtitle|count|trailing|chevron|card|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: icon, color, surface, title, subtitle, count, trailing, chevron, card, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecommendationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:exercise|rationale|acceptLabel|keepLabel|onAccept|onKeep|onEdit|style|key|ref|className|style|children)$/]",
        "message": "<RecommendationCard> doesn't accept that prop. Declared props: exercise, rationale, acceptLabel, keepLabel, onAccept, onKeep, onEdit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RestTimer'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|remaining|onAddTime|onPauseResume|onSkip|onContinue|style|key|ref|className|style|children)$/]",
        "message": "<RestTimer> doesn't accept that prop. Declared props: state, remaining, onAddTime, onPauseResume, onSkip, onContinue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RestTimer'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:running|paused|ready)$/]",
        "message": "<RestTimer> state must be one of 'running' | 'paused' | 'ready'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|iconColor|detail|trailing|color|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, icon, iconColor, detail, trailing, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|elapsed|completedSets|totalSets|exercises|style|key|ref|className|style|children)$/]",
        "message": "<SessionHeader> doesn't accept that prop. Declared props: title, elapsed, completedSets, totalSets, exercises, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SetInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|width|disabled|style|key|ref|className|style|children)$/]",
        "message": "<SetInput> doesn't accept that prop. Declared props: value, onChange, width, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SetRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|values|state|note|locked|onToggle|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SetRow> doesn't accept that prop. Declared props: index, values, state, note, locked, onToggle, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SetRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:pending|current|completed)$/]",
        "message": "<SetRow> state must be one of 'pending' | 'current' | 'completed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|detail|status|isToday|style|key|ref|className|style|children)$/]",
        "message": "<StatusRow> doesn't accept that prop. Declared props: title, detail, status, isToday, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:completed|skipped|missed|in-progress|ready|scheduled)$/]",
        "message": "<StatusRow> status must be one of 'completed' | 'skipped' | 'missed' | 'in-progress' | 'ready' | 'scheduled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepperRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|value|on|onIncrement|onDecrement|onToggle|onPress|last|style|key|ref|className|style|children)$/]",
        "message": "<StepperRow> doesn't accept that prop. Declared props: label, variant, value, on, onIncrement, onDecrement, onToggle, onPress, last, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepperRow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:stepper|picker|toggle)$/]",
        "message": "<StepperRow> variant must be one of 'stepper' | 'picker' | 'toggle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|icon|label|key|ref|className|style|children)$/]",
        "message": "<TabBarTab> doesn't accept that prop. Declared props: key, icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='UpcomingCalendarDay'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|date|workout|done|isToday|key|ref|className|style|children)$/]",
        "message": "<UpcomingCalendarDay> doesn't accept that prop. Declared props: label, date, workout, done, isToday."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
